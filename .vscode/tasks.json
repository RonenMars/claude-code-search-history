{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Electron Dev",
      "type": "shell",
      "command": "pnpm dev -- --inspect=9229 --remote-debugging-port=9222",
      "isBackground": true,
      "options": {
        "shell": {
          "executable": "/bin/zsh",
          "args": ["-l", "-c"]
        }
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ]
}
